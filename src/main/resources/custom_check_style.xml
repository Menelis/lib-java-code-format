<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <!-- Enables @SuppressWarnings annotations to suppress Checkstyle violations -->
    <module name="SuppressWarningsFilter"/>
    <!-- Flags methods exceeding column limit -->
    <module name="LineLength">
        <property name="max" value="200"/>
    </module>

    <module name="TreeWalker">

        <!-- Required companion module for SuppressWarningsFilter -->
        <module name="SuppressWarningsHolder"/>

        <module name="AvoidStarImport">
            <property name="severity" value="error"/>
        </module>
        <module name="FinalParameters">
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, FOR_EACH_CLAUSE"/>
        </module>

        <module name="SummaryJavadoc">
            <property name="period" value="."/>
        </module>
    </module>
</module>